# HTTP
HTTP_PORT=8080

# PostgreSQL
POSTGRES_DSN=postgres://notifier:notifier@localhost:5432/notifications?sslmode=disable

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Retry policy
MAX_ATTEMPTS=3
RETRY_DELAY_MS=5000

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# SMS
SMS_PROVIDER_URL=
SMS_PROVIDER_SID=
SMS_PROVIDER_TOKEN=
SMS_FROM=

# Push (FCM legacy)
FCM_SERVER_KEY=
FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send